<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PensionAlchemy" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 시스템 프리뷰 윈도우(기본 스플래시) 비활성화: OS 차원에서 앱 아이콘이 먼저 뜨는 현상 방지 -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/splash_bg_color</item>

        <!-- Android 12+ (API 31+) 시스템 스플래시 화면에서 appicon이 뜨지 않도록 투명 처리 -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/splash_bg_color</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">0</item>
    </style>
</resources>